---
const { name, link, external } = Astro.props;
const pathname = Astro.url.pathname;
---

{external ?
    <a
        class=`${pathname === link ? "text-white" : ""} font-display font-normal text-2xl text-gray-100 hover:text-white`
        href={link}
        rel="noopener noreferrer external"
        target="_blank"
    >
        {name}
    </a>:
    <a
        class=`${pathname === link ? "text-white" : ""} font-display font-normal text-2xl text-gray-100 hover:text-white`
        href={link}
    >
        {name}
    </a>
}