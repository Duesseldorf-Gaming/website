---
// League as in the german liga, not league of legends the game ;D
import GameIcon from "../elements/icons/GameIcon.astro";

interface Props {
    game: string;
    league: string;
}

const { game, league } = Astro.props;
---

<div class="flex h-fit space-x-3">
    <GameIcon class="h-20 md:h-30 w-auto max-w-40 md:max-w-65" game={game} />
    <span class="text-base md:text-2xl font-body font-extrabold">{league}. Liga</span>
</div>
