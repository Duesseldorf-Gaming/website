
---
import { getCollection } from "astro:content";
import TeamCard from "@components/ui/elements/cards/TeamCard.astro";
import { activeGames } from "@data/constants";

interface Props {
    games?: Array<
        | "valorant"
        | "league"
        | "overwatch"
        | "rocket_league"
        | "counter_strike"
        | "rainbow"
    >;
}

const { games = activeGames } = Astro.props;

const allTeams = await getCollection("teams");

type Game =
    | "valorant"
    | "league"
    | "overwatch"
    | "rocket_league"
    | "counter_strike"
    | "rainbow";

const groupedTeams: Record<
    Game,
    typeof allTeams
> = {
    valorant: [],
    league: [],
    overwatch: [],
    rocket_league: [],
    counter_strike: [],
    rainbow: [],
};

for (const game of Object.keys(groupedTeams) as Game[]) {
    groupedTeams[game] = allTeams
        .filter((team) => team.data.game === game)
        .sort((a, b) =>
            a.data.league.localeCompare(b.data.league)
        );
}

---

<div class="flex flex-wrap gap-3.5 md:gap-20 justify-center 3xl:justify-normal">
    {games.map((game) =>
        groupedTeams[game].map((team) => (
                <TeamCard
                        game={game}
                        league={team.data.league}
                        team={team.data.name}
                />
        ))
    )}
</div>
