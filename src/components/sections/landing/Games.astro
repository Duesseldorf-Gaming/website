---

import GameCard from "../../ui/elements/cards/GameCard.astro";
import {activeGames} from "@data/constants";
---
<div class="global-padding min-h-fit">
    <div class="">
        <h1 class="pt-120 text-6xl font-display">
            Unsere Games
        </h1>
        <div class="pt-7 flex flex-row flex-wrap gap-x-4 gap-y-4 justify-center xl:justify-normal">
            {activeGames.map(game => (
                    <GameCard game={game}></GameCard>
            ))}
        </div>
    </div>
</div>