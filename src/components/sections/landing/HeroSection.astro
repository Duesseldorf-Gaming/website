---
import { Image } from 'astro:assets';
import Button from "@components/ui/elements/buttons/Button.astro";

import image from "@images/image.png"
---

<div
        class="bg-hero-pattern bg-fixed bg-cover bg-center h-svh min-h-1000 flex flex-col overflow-hidden relative"
>
    <div class="hidden xl:block absolute xl:pl-360 3xl:pl-560 pt-140">
        <div class="min-h-890 h-890">
            <Image class="min-h-890 min-w-1360" src={image} alt="decoration of all games"></Image>
        </div>
    </div>
    <div class="px-20 xs:px-50 1.5xl:px-100 min-h-full z-10">
        <h1 class="sm:mt-70 1.5xl:mt-120 max-h-min table">
            <span class="text-6xl sm:text-8xl font-display align-text-bottom">Düsseldorf</span><br/>
            <span class="text-6xl sm:text-8xl font-display align-text-top">Gaming</span>
        </h1>
        <p class="text-2xl sm:text-2xl font-body max-w-415">
            #Düsseldominanz im Gaming - NRWs Hauptstadt ruft dich
        </p>
        <div class="pt-120">
            <Button text="TEAM BEITRETEN" link="https://forms.gle/3AvgxKSjN7grZt9x7"></Button>
        </div>
    </div>
</div>